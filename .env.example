POSTGRES_DB=elyx
POSTGRES_USER=elyx_user
POSTGRES_PASSWORD=elyx_pass
POSTGRES_PORT=5432

BACKEND_PORT=3000
FRONTEND_PORT=5173
REDIS_PORT=6379

DATABASE_URL=postgres://elyx_user:elyx_pass@postgres:5432/elyx
REDIS_URL=redis://redis:6379

# URL publica del backend para construir URLs de archivos subidos (comprobantes, etc.)
# En local: http://localhost:3000
# En produccion: https://elyx-app.com (o la URL real del servidor)
PUBLIC_FILES_BASE_URL=http://localhost:3000

# URL del backend que usa el frontend para llamadas API y WebSocket
# En local: http://localhost:3000
# En produccion con reverse proxy (nginx): dejarlo vacio para usar URLs relativas
# En produccion sin reverse proxy: http://elyx-app.com:3000
# VITE_API_URL=http://localhost:3000

# Configuracion SMTP para envio de correos
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASS=tu-password-app
# SMTP_FROM="Elyx <no-reply@elyx.mx>"
#
# Transporte: auto | smtp | resend
# En "auto" se usa SMTP si SMTP_HOST esta definido; Resend en caso contrario.
# Resend EXIGE un dominio propio verificado: con un correo de Gmail/Hotmail
# devuelve 422. Si usas un buzon personal, deja MAIL_PROVIDER=smtp.
MAIL_PROVIDER=auto
# RESEND_API_KEY=

# Sesiones: access token corto + refresh token rotatorio en cookie HttpOnly
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Vigencia del refresh cuando el usuario NO marca "Mantener sesion iniciada"
# (la cookie no lleva expires, asi que muere al cerrar el navegador).
REFRESH_TOKEN_TTL_SESSION_HOURS=12
# Exige token Bearer en los endpoints protegidos (mismo valor que usa docker-compose).
AUTH_REQUIRED=true

# En produccion las cookies SIEMPRE van con Secure; en local dejarlo en false.
COOKIE_SECURE=false
# Secreto para firmar los tokens CSRF (doble envio). Cambiar en produccion.
CSRF_SECRET=
# Clave para cifrar el secreto TOTP de MFA (AES-256-GCM). Cambiar en produccion.
MFA_ENCRYPTION_KEY=
# Generarlos con Powershell
# function New-Secret {
#   $b = New-Object byte[] 32
#   [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   ($b | ForEach-Object { $_.ToString('x2') }) -join ''
# }
# 
# New-Secret   # pega el resultado en CSRF_SECRET
# New-Secret   # pega otro distinto en MFA_ENCRYPTION_KEY

# Segundo CAPTCHA propio (operacion matematica)
CAPTCHA_MATH_ENABLED=true
# always | after_failures
CAPTCHA_MATH_ENFORCE=after_failures

# Telemetria de comportamiento: soft (medir) | strict (rechazar) | off
BEHAVIOR_ENFORCE=soft

# Origenes permitidos por CORS (separados por coma). Se admite la variante con y sin www.
# CORS_ALLOWED_ORIGINS=https://elyx-app.com,https://www.elyx-app.com

# Cloudflare Turnstile (CAPTCHA)
# Llaves de prueba oficiales para desarrollo (always-pass):
#   VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# En produccion: generar las llaves reales en el dashboard de Cloudflare.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# "true" para validar el token contra Cloudflare (fail-closed). En dev puede ir "false" (fail-open).
TURNSTILE_ENABLED=false

# Origenes autorizados para CORS (lista separada por comas).
# Si se deja vacio, se usa FRONTEND_URL. En produccion, fijar el/los dominios reales,
# ej: https://elyx-app.com
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Retencion de datos (docs/politica-privacidad.md)
# ---------------------------------------------------------------------------
# "false" desactiva la purga automatica. Se ejecuta todos los dias a las 4:30 AM.
# Los datos financieros (cuotas, pagos, recibos) NO se purgan: su plazo de 7
# anios es un minimo fiscal, no un maximo.
RETENCION_ENABLED=true
# Telemetria de comportamiento: maximo 30 dias.
RETENCION_TELEMETRIA_DIAS=30
# Auditoria de inicio de sesion: hasta 12 meses.
RETENCION_AUDITORIA_DIAS=365
# Tokens de refresco: 30 dias despues de expirar o de revocarse.
RETENCION_TOKENS_DIAS=30

# ---------------------------------------------------------------------------
# Registro publico de condominios ("Crea tu condominio")
# ---------------------------------------------------------------------------
# "false" desactiva por completo el alta publica: solo el superusuario crea condominios.
REGISTRO_PUBLICO_ENABLED=true
# Horas de vigencia del enlace de verificacion de correo antes de purgarse.
REGISTRO_EXPIRACION_HORAS=24
# Dias que vive un link de invitacion de condominos.
INVITACION_EXPIRACION_DIAS=30
# URL publica usada para construir los enlaces enviados por correo.
PUBLIC_APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Suscripcion a Elyx (solo para la instancia oficial; el self-hosting va en false)
# ---------------------------------------------------------------------------
# "true" exige suscripcion activa para crear invitaciones y altas.
SUSCRIPCION_ENABLED=false
# Proveedor de cobro: MANUAL (transferencia + confirmacion del superusuario) | NULL
SUSCRIPCION_PROVIDER=MANUAL
# Dias de gracia tras crear el condominio. 0 = pago inmediato (sin trial).
SUSCRIPCION_DIAS_PRUEBA=0
# Monto mensual de la suscripcion (MXN). Se guarda en la suscripcion al crearla.
SUSCRIPCION_MONTO_BASE=0
# Precio: cuota base + costo por unidad, con piso mensual. Todo NETO (sin IVA).
# Ejemplo con 30 unidades: 200 + (30 x 7) = 410 netos; + IVA 16% = 475.60 cobrados.
SUSCRIPCION_PRECIO_BASE=200
SUSCRIPCION_PRECIO_UNIDAD=7
# Piso mensual: evita que un condominio minusculo pague menos que esto.
SUSCRIPCION_PRECIO_PISO=250
# IVA desglosado (exclusive). El IVA NO es ingreso de Elyx.
SUSCRIPCION_IVA_PORCENTAJE=16
# Dias de gracia por impago antes de suspender (solo lectura).
SUSCRIPCION_DIAS_GRACIA=7
# Dias antes de eliminar un condominio que nunca pago (solo con cobro activo).
SUSCRIPCION_PURGA_DIAS=30
#
# ---------------------------------------------------------------------------
# Stripe (solo con SUSCRIPCION_PROVIDER=STRIPE)
# ---------------------------------------------------------------------------
# Clave secreta (sk_test_... en pruebas, sk_live_... en produccion).
STRIPE_SECRET_KEY=
# Secreto del endpoint de webhooks (whsec_...). Con `stripe listen` en local
# lo imprime la CLI al arrancar.
STRIPE_WEBHOOK_SECRET=
# Secreto del webhook de Connect (cobro de cuotas). Es un endpoint APARTE:
# Stripe separa los eventos por scope y los direct charges llegan en
# "Connected accounts", con su propio secreto. Endpoint:
#   https://tu-dominio/api/webhooks/stripe/connect
# Eventos a suscribir: checkout.session.completed, account.updated
STRIPE_WEBHOOK_SECRET_CONNECT=
# Price IDs recurrentes creados en el Dashboard (price_...). Si se dejan
# vacios, el backend usa price_data dinamico con el monto configurado arriba.
STRIPE_PRICE_BASE=
STRIPE_PRICE_UNIDAD=
# Tax Rate del 16% (txr_...). Stripe Tax no cubre Mexico de forma fiable:
# usar un Tax Rate explicito con tax_behavior=exclusive.
STRIPE_TAX_RATE_ID=
# Clave publica del frontend (pk_test_... / pk_live_...). Sin ella el checkout
# embebido muestra un aviso en vez del formulario de pago.
# OJO: se inyecta en tiempo de build, asi que al cambiarla hay que recrear
# el contenedor del frontend (docker compose up -d --force-recreate frontend).
VITE_STRIPE_PUBLISHABLE_KEY=
# Instrucciones de pago que se muestran al administrador (texto libre).
SUSCRIPCION_DATOS_PAGO=
