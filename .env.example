POSTGRES_DB=elyx
POSTGRES_USER=elyx_user
POSTGRES_PASSWORD=elyx_pass
POSTGRES_PORT=5432

BACKEND_PORT=3000
FRONTEND_PORT=5173
REDIS_PORT=6379

DATABASE_URL=postgres://elyx_user:elyx_pass@postgres:5432/elyx
REDIS_URL=redis://redis:6379

# URL publica del backend para construir URLs de archivos subidos (comprobantes, etc.)
# En local: http://localhost:3000
# En produccion: https://elyx-app.com (o la URL real del servidor)
PUBLIC_FILES_BASE_URL=http://localhost:3000

# URL del backend que usa el frontend para llamadas API y WebSocket
# En local: http://localhost:3000
# En produccion con reverse proxy (nginx): dejarlo vacio para usar URLs relativas
# En produccion sin reverse proxy: http://elyx-app.com:3000
# VITE_API_URL=http://localhost:3000

# Configuracion SMTP para envio de correos
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASS=tu-password-app
# SMTP_FROM="Elyx <no-reply@elyx.mx>"

# Cloudflare Turnstile (CAPTCHA)
# Llaves de prueba oficiales para desarrollo (always-pass):
#   VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# En produccion: generar las llaves reales en el dashboard de Cloudflare.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# "true" para validar el token contra Cloudflare (fail-closed). En dev puede ir "false" (fail-open).
TURNSTILE_ENABLED=false

# Origenes autorizados para CORS (lista separada por comas).
# Si se deja vacio, se usa FRONTEND_URL. En produccion, fijar el/los dominios reales,
# ej: https://elyx-app.com
CORS_ALLOWED_ORIGINS=
