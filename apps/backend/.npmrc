# `typeorm@0.3.x` declara `peerOptional ioredis@^5.0.4`, pero el proyecto usa
# `ioredis@6` (que es lo que pide `@nest-lab/throttler-storage-redis`). El peer
# de typeorm es opcional y solo aplica si se usa el driver de Redis, que aqui no
# se usa: la app habla con Postgres via `pg`.
#
# Sin esta linea, cualquier `npm install` dentro del contenedor falla con
# ERESOLVE y no hay forma de agregar dependencias. El Dockerfile ya pasaba
# `--legacy-peer-deps` de forma explicita; esto hace que los comandos manuales
# se comporten igual.
legacy-peer-deps=true
