{
  "name": "Elyx Frontend",
  "dockerComposeFile": [
    "../docker-compose.yml"
  ],
  "service": "frontend",
  "runServices": [
    "postgres",
    "backend",
    "frontend"
  ],
  "workspaceFolder": "/app",
  "shutdownAction": "stopCompose",
  "overrideCommand": false,
  "forwardPorts": [3000, 5173],
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
